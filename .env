# ============================================================
# CONFIGURAÇÕES DA CÂMERA
# ============================================================
# Para webcam: VIDEO_SOURCE=0
# Para vídeo: VIDEO_SOURCE=video_teste.mp4
# Para RTSP: VIDEO_SOURCE=rtsp://usuario:senha@192.168.1.100:554/stream
VIDEO_SOURCE=video_teste.mp4

# Identificadores
CAMERA_ID=posto-costura-01
OPERATOR_ID=operador-001

# ============================================================
# MODELOS YOLO
# ============================================================
# Caminho dos modelos (crie a pasta models/)
OBJECT_MODEL_PATH=models/glove_workstation.pt
POSE_MODEL_PATH=models/pose_model.pt

# Dispositivo: cpu, 0, 1, mps
DEVICE=cpu

# ============================================================
# THRESHOLDS DE DETECÇÃO
# ============================================================
OBJECT_CONFIDENCE=0.45
POSE_CONFIDENCE=0.40
KEYPOINT_CONFIDENCE=0.35

# Processar inferência a cada N frames (reduz consumo)
INFERENCE_EVERY_N_FRAMES=2

# Tamanho da imagem para inferência
IMAGE_SIZE=640

# ============================================================
# CONTROLE DE ESTADO
# ============================================================
# Tempo mínimo para confirmar mudança de etapa (segundos)
STAGE_DEBOUNCE_SECONDS=0.30
# ============================================================
# SEGURANÇA (Zona da Agulha)
# ============================================================
HAZARD_ALERT_COOLDOWN_SECONDS=2.0

# ============================================================
# ERGONOMIA (Postura)
# ============================================================
# Ângulo máximo permitido para inclinação do tronco (graus)
MAX_TRUNK_ANGLE_DEGREES=20

# Tempo que o operador deve manter a postura incorreta para gerar alerta
POSTURE_HOLD_SECONDS=3

# Cooldown entre alertas de postura (segundos)
POSTURE_ALERT_COOLDOWN_SECONDS=15

# ============================================================
# EVENTOS
# ============================================================
# Arquivo local para eventos (JSONL)
LOCAL_EVENT_FILE=events.jsonl

# ============================================================
# SUPABASE (Opcional - remova as linhas para usar apenas offline)
# ============================================================
SUPABASE_URL=https://enpptyboivhnqsdchuhk.supabase.co
